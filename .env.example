# catalyst-history-archive — environment template
#
# Copy this file to .env (which is gitignored) and fill in values for any
# fetcher you intend to run. None of these are required to USE the dataset —
# only to refresh it.

# --- Identification (recommended for all fetchers) ---
# A polite User-Agent identifying our crawler to upstream services.
HTTP_USER_AGENT="catalyst-history-archive/0.1 (+https://github.com/lloydduhon/catalyst-history-archive)"

# Contact email surfaced in headers; helpful if an upstream needs to reach us.
HTTP_CONTACT_EMAIL=""

# --- Rate limiting ---
# Requests per second per upstream host. Conservative defaults.
LIDONATION_RPS=1.5
MILESTONES_RPS=1.0
PROJECTCATALYST_IO_RPS=2.0
WAYBACK_RPS=0.5

# --- Optional: on-chain (deferred, not in v1) ---
# BLOCKFROST_PROJECT_ID=
# KOIOS_API_TOKEN=

# --- Optional: Catalyst Voices Gateway (deferred until endpoint stabilizes) ---
# CATALYST_VOICES_GATEWAY_BASE_URL=
# CATALYST_VOICES_INTERNAL_API_KEY=

# --- Local paths ---
# Where to write provenance captures during a fetch run. Defaults to repo-relative.
PROVENANCE_ROOT="./data"
