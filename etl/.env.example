# etl/.env.example
#
# Copy to etl/.env (gitignored) before running any fetcher. The validator
# does not require any environment variables.
#
# Most fetchers respect a "polite client" policy: identify yourself, throttle
# requests, snapshot raw responses for replay.

# --- Identification ---
HTTP_USER_AGENT="catalyst-history-archive/0.1 (+https://github.com/lloydduhon/catalyst-history-archive)"
HTTP_CONTACT_EMAIL=""

# --- Per-upstream rate limits (requests per second) ---
LIDONATION_RPS=1.5
MILESTONES_RPS=1.0
PROJECTCATALYST_IO_RPS=2.0
WAYBACK_RPS=0.5

# --- Output paths ---
# Where fetchers write their raw captures. Defaults to ../data relative to etl/.
PROVENANCE_ROOT="../data"

# --- Phase 5+: optional on-chain ---
# BLOCKFROST_PROJECT_ID=
# KOIOS_API_TOKEN=

# --- Future: Catalyst Voices Gateway (deferred) ---
# CATALYST_VOICES_GATEWAY_BASE_URL=
