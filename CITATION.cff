type: dataset
license: CC-BY-4.0
repository-code: "https://github.com/lloydduhon/cardano-treasury-history-archive"
keywords:
  - cardano
  - project-catalyst
  - governance
  - blockchain
  - open-data
  - decentralized-funding
references:
